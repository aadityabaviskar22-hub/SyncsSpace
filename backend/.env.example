# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb://localhost:27017/project_hub

# JWT Secrets & Expirations
JWT_SECRET=super_secret_jwt_access_key_change_in_production_123!
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production_456!
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins
CLIENT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:4200

# File Uploads Directory & Limits
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
